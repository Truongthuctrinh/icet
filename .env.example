# Chép file này thành .env rồi điền giá trị:  cp .env.example .env
# KHÔNG đưa file .env lên git (đã có trong .gitignore)

# ---- PostgreSQL ----
POSTGRES_USER=icet
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=icet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
# Tạo khoá ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=thay_bang_khoa_ngau_nhien_dai_it_nhat_32_ky_tu
ACCESS_TOKEN_EXPIRE_MINUTES=60
READ_TOKEN_EXPIRE_MINUTES=30

# ---- Chống thu thập nội dung ----
MAX_PARAGRAPHS_PER_REQUEST=10
RATE_OPEN_CHAPTER_PER_MIN=10
RATE_PARAGRAPHS_PER_MIN=60
RATE_LOGIN_PER_5MIN=5
RATE_COMMENT_PER_MIN=5
RATE_UPLOAD_PER_MIN=10
HONEYPOT_BAN_MINUTES=30
# Proxy được tin header X-Forwarded-For (Vite dev server chạy trên máy)
TRUSTED_PROXIES=127.0.0.1,::1

# ---- Phát hiện đạo văn bằng embedding (worker) ----
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Đo bằng: python -m app.scripts.calibrate_embedding
SEMANTIC_THRESHOLD=0.65
TASK_QUEUE_ENABLED=true

# ---- Ảnh tải lên ----
MAX_UPLOAD_MB=2
# MEDIA_DIR=   (để trống = backend/media)

# ---- Dữ liệu mẫu ----
SEED_ADMIN_PASSWORD=admin12345
